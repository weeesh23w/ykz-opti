{
  "rewrites": [
    { "source": "/success.html", "destination": "/website/success.html" },
    { "source": "/success",      "destination": "/website/success.html" },
    { "source": "/assets/(.*)", "destination": "/website/assets/$1" },
    { "source": "/style.css",   "destination": "/website/style.css" },
    { "source": "/script.js",   "destination": "/website/script.js" },
    { "source": "/",            "destination": "/website/index.html" }
  ]
}
