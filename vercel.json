{
  "functions": {
    "api/*.py": {
      "runtime": "vercel-python@0.1.0"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.py" },
    { "src": "/", "dest": "/website/index.html" },
    { "src": "/success.html", "dest": "/website/success.html" },
    { "src": "/assets/(.*)", "dest": "/website/assets/$1" },
    { "src": "/(.*).(css|js|png|jpg|jpeg|gif|svg|ico)", "dest": "/website/$1.$2" }
  ]
}
