{
  "routes": [
    { "src": "/api/check",    "dest": "/api/check.py" },
    { "src": "/api/activate", "dest": "/api/activate.py" },
    { "src": "/api/generate", "dest": "/api/generate.py" },
    { "src": "/success.html", "dest": "/website/success.html" },
    { "src": "/success",      "dest": "/website/success.html" },
    { "src": "/assets/(.*)",  "dest": "/website/assets/$1" },
    { "src": "/style\\.css",  "dest": "/website/style.css" },
    { "src": "/script\\.js",  "dest": "/website/script.js" },
    { "src": "/",             "dest": "/website/index.html" }
  ]
}
